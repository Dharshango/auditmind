# AUDITMIND Backend Environment Configuration Template

# Hindsight Memory Engine
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_INFERENCE_URL=https://inference.hindsight.vectorize.io/v1
HINDSIGHT_DEFAULT_BANK_PREFIX=auditmind-org

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b

# Database Configuration
# Local SQLite Async for local development:
DATABASE_URL=sqlite+aiosqlite:///./auditmind.db
# PostgreSQL Async for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auditmind

# Service URLs & Ports
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
SECRET_KEY=auditmind-dev-secret-key-change-in-production-1234567890
ENVIRONMENT=development
DEBUG=true
