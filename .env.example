# AUDITMIND Environment Configuration Template

# Environment Mode
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=auditmind-dev-secret-key-change-in-production-1234567890

# Frontend Environment Variables (Vercel)
# If omitted or offline, AUDITMIND runs in instant high-fidelity interactive demo mode.
# If connecting to a live backend, set this to your backend URL:
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Database Configuration
# Local SQLite Async for development / initial tests:
DATABASE_URL=sqlite+aiosqlite:///./auditmind.db
# Production PostgreSQL Async:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auditmind

# Hindsight Memory Engine
# Sign up at https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_DEFAULT_BANK_PREFIX=auditmind-org

# Groq LLM API
# Sign up at https://groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS & Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
